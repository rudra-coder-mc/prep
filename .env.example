# Every value here has a working default in compose.yaml, so the stack runs with
# no .env at all. Copy this file to .env and change them before putting the
# platform anywhere other than localhost.

POSTGRES_USER=prep
POSTGRES_PASSWORD=prep
POSTGRES_DB=prep

APP_PORT=3000

# A day for streak purposes is a calendar day in this timezone, not the device's.
# Set it once and leave it, so travelling never shifts when a streak rolls over.
APP_TIMEZONE=UTC

BETTER_AUTH_SECRET=insecure-development-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

SEED_USER_EMAIL=dev@prep.test
SEED_USER_PASSWORD=dev
